{
  "type": "object",
  "additionalProperties": false,
  "required": ["materias"],
  "properties": {
    "materias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nome", "pagina", "topicos"],
        "properties": {
          "nome": { "type": "string", "minLength": 1 },
          "pagina": { "type": "integer", "minimum": 1 },
          "topicos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["texto", "pagina", "subtopicos"],
              "properties": {
                "texto": { "type": "string", "minLength": 1 },
                "pagina": { "type": "integer", "minimum": 1 },
                "subtopicos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["texto", "pagina"],
                    "properties": {
                      "texto": { "type": "string", "minLength": 1 },
                      "pagina": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
